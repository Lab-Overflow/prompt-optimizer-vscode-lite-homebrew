#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path


target = Path(__file__).with_name("prompt-optimizer-mini")
os.environ["PROMPT_OPTIMIZER_COMMAND"] = Path(sys.argv[0]).name or "prompt-optimizer-lite"
os.execv(str(target), [sys.argv[0], *sys.argv[1:]])
